{
  "name": "pulse-veto",
  "version": "1.0.0",
  "private": true,
  "description": "PulseVeto — VALORANT 地圖 Ban/Pick、選邊、比分與轉播系統",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "admin:create": "tsx scripts/create-admin.ts",
    "maps:sync": "tsx scripts/sync-maps.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.0.2",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "prisma": "6.12.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "ip-address": "10.7.3",
    "engine.io": "6.6.11",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "qs": "6.16.0"
  }
}
